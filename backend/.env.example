# Database connection URL (PostgreSQL)
# Works with postgresql://, postgresql+psycopg://, or postgresql+psycopg2://
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/vahanone_db

# JWT Security
JWT_SECRET_KEY=vahanone_dev_secret_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Role Defaults
DEFAULT_USER_ROLE=member
ADMIN_ROLE_NAME=admin

# Background Scheduler
ENABLE_REMINDER_SCHEDULER=true
REMINDER_SCHEDULER_INTERVAL_MINUTES=60

# Demo Data Seeding on startup (true/false)
SEED_DEMO_DATA=true

# Optional CORS allowed origins (comma-separated, e.g. https://my-frontend.onrender.com)
# CORS_ORIGINS=https://vahanone.onrender.com,https://vahanone.vercel.app
